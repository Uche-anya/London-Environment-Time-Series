            "group": "table",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "countRows": false
                }
