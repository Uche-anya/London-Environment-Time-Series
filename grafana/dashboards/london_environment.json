        "spec": {
          "id": 8,
          "title": "Daily Pollution Trend (µg/m³)",
          "description": "Compares daily average NO₂ , PM₂.₅ and O₃ concentrations at London Bloomsbury from 2022 to 2025.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
