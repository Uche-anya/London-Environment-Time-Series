      "panel-20": {
        "kind": "Panel",
        "spec": {
          "id": 20,
          "title": "Data Freshness (latest reading per table)",
          "description": "How current each serving table is. Deliberately NOT filtered by the dashboard time range, so narrowing the time picker cannot make stale data look fresh. days_behind is measured against today.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efmiwcfbgjrwgc"
                      },
                      "spec": {
                        "dataset": "environment_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT 'daily_air_quality_metrics' AS table_name,\n       MAX(reading_date) AS latest_reading,\n       (CURRENT_DATE - MAX(reading_date)) AS days_behind\nFROM daily_air_quality_metrics\nUNION ALL\nSELECT 'daily_weather_metrics',\n       MAX(reading_date),\n       (CURRENT_DATE - MAX(reading_date))\nFROM daily_weather_metrics\nUNION ALL\nSELECT 'hourly_environment_metrics',\n       MAX(reading_date),\n       (CURRENT_DATE - MAX(reading_date))\nFROM hourly_environment_metrics\nORDER BY table_name;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
