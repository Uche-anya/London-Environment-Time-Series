# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# -------------------------
# AWS / S3 (raw DEFRA data)
# -------------------------
AWS_REGION=eu-north-1
# boto3 only recognizes these exact variable names.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-s3-bucket-name
S3_RAW_PREFIX=raw
LOCAL_RAW_DIR=data/raw
DEFRA_SITE_FOLDER=defra/london_bloomsbury
WEATHER_SITE_FOLDER=open_meteo

# -------------------------
# Location / weather (Open-Meteo)
# -------------------------
CITY=London
SITE_NAME=London Bloomsbury
LATITUDE=51.522290
LONGITUDE=-0.125889
START_DATE=2022-01-01
TIMEZONE=GMT

# -------------------------
# TimescaleDB / PostgreSQL
# -------------------------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=environment_db
# Inside Docker Compose use the service name "timescaledb"; use "localhost" for local runs.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# -------------------------
# Grafana
# -------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password

# -------------------------
# Pipeline image (prod / EC2 only)
# -------------------------
# Set to the ECR image so the box pulls instead of building. Get the URL from
# `terraform output ecr_repository_url`. Left unset, docker compose builds locally.
# PIPELINE_IMAGE=<account>.dkr.ecr.eu-north-1.amazonaws.com/london-environment-pipeline:latest
