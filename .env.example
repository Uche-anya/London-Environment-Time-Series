# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# -------------------------
# AWS / S3 (raw DEFRA data)
# -------------------------
AWS_REGION=eu-north-1
# boto3 only recognizes these exact variable names.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-s3-bucket-name
S3_RAW_PREFIX=raw
LOCAL_RAW_DIR=data/raw
DEFRA_SITE_FOLDER=defra/london_bloomsbury

# Years of data to extract / process (comma-separated)
YEARS=2022,2023,2024,2025,2026

# -------------------------
# Location / weather (Open-Meteo)
# -------------------------
CITY=London
SITE_NAME=London Bloomsbury
LATITUDE=51.5072
LONGITUDE=-0.1276
START_DATE=2022-01-01
END_DATE=2026-06-11
TIMEZONE=Europe/London

# -------------------------
# TimescaleDB / PostgreSQL
# -------------------------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=environment_db
# Inside Docker Compose use the service name "timescaledb"; use "localhost" for local runs.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# -------------------------
# Grafana
# -------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password

# -------------------------
# Airflow (docker-compose.prod.yml only — all optional, sane defaults exist)
# -------------------------
# Airflow's own metadata database (separate from the TimescaleDB serving layer above).
AIRFLOW_METADATA_USER=airflow
AIRFLOW_METADATA_PASSWORD=airflow
AIRFLOW_METADATA_DB=airflow
# Admin login created for the Airflow UI on first boot.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Set to a strong random value in real prod (shared by webserver + scheduler).
AIRFLOW_SECRET_KEY=change-me-in-prod
# Optional: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
AIRFLOW_FERNET_KEY=
# Optional: pull a prebuilt image (e.g. from ECR) instead of building locally.
# AIRFLOW_IMAGE=<acct>.dkr.ecr.<region>.amazonaws.com/london-environment:<sha>
