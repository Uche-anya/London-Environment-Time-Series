# Production image for the London Environment pipeline.
#
# Unlike the dev Dockerfile (which relies on the Astro CLI mounting the project
# into the container at `astro dev start` time), this image BAKES the code in so
# it can run on a clean host with plain `docker compose` and be pushed to ECR.
# Keep the copied dirs in sync with the volume mounts in docker-compose.override.yml.

FROM quay.io/astronomer/astro-runtime:12.7.1

COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# astro-runtime runs as the unprivileged `astro` user; AIRFLOW_HOME=/usr/local/airflow.
# The DAG chdirs to /usr/local/airflow and imports pipelines/src/data_quality from there.
COPY --chown=astro:astro dags/         /usr/local/airflow/dags/
COPY --chown=astro:astro pipelines/    /usr/local/airflow/pipelines/
COPY --chown=astro:astro src/          /usr/local/airflow/src/
COPY --chown=astro:astro data_quality/ /usr/local/airflow/data_quality/
COPY --chown=astro:astro sql/          /usr/local/airflow/sql/
